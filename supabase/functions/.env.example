# Local values for the host-Deno dev server (supabase/functions/_dev/serve.ts).
# On Supabase, SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service role key from `supabase status`>
# Public URL of this functions host (used to build webhook URLs shown in Settings).
FUNCTIONS_PUBLIC_URL=http://127.0.0.1:54329/functions/v1
# Force mock providers for every integration (local dev and tests).
MOCK_PROVIDERS=true
# Shared secret that pg_cron / internal callers send in x-internal-key.
INTERNAL_KEY=local-internal-key
# Shorter debounce in tests (seconds). Production default is the company setting (8s).
DEBOUNCE_SECONDS_OVERRIDE=
