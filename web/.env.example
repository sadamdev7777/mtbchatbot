# ---------------------------------------------------------------------------
# MTB Inbox environment variables
#   web/.env.local                  → Next.js (Netlify env vars in production)
#   supabase/functions/.env         → Edge Functions locally (Supabase secrets in production;
#                                     SUPABASE_URL/ANON_KEY/SERVICE_ROLE_KEY are injected by Supabase)
# Integration keys (Meta, Claude, TravelBoost, IMAP, HRBoost…) are NOT env vars: the owner enters
# them in Settings › Integrations and they are stored in Supabase Vault.
# ---------------------------------------------------------------------------

# --- web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, never NEXT_PUBLIC>
# Locally the functions run on host Deno (54329); in production: https://<ref>.supabase.co/functions/v1
NEXT_PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54329/functions/v1
# Dev simulator page (only works while Meta WhatsApp is not connected)
NEXT_PUBLIC_ENABLE_SIMULATOR=true
# Demo deployments only: shows the owner/admin 2-step code on screen (seeded @mtb.test mailboxes do not exist). Never with real keys.
# DEMO_MODE=true
APP_URL=http://127.0.0.1:3000
# Fallback SMTP for 2-step codes/invites until Settings › Integrations › SMTP is connected
# (locally: Mailpit from `supabase start`; production: your Supabase project's SMTP settings)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MTB Inbox <no-reply@muslimtravelbug.com>
# Secret for hashing 2-step codes (defaults to the service role key)
MFA_CODE_SECRET=
# Optional error collector (Sentry/Slack/any HTTP endpoint) for server + browser errors
ERROR_WEBHOOK_URL=

# --- Edge Functions ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>   (same as above)
FUNCTIONS_PUBLIC_URL=http://127.0.0.1:54329/functions/v1
FUNCTIONS_INTERNAL_URL=http://127.0.0.1:54329/functions/v1
# Shared secret pg_cron sends as x-internal-key (also stored in Vault as edge_internal_key)
INTERNAL_KEY=<long random string>
# true = every integration uses its mock (local dev / tests only)
MOCK_PROVIDERS=true
META_GRAPH_VERSION=v24.0
# Signing secrets used only by the simulator / mocks
META_MOCK_APP_SECRET=mock-app-secret
TRAVELBOOST_MOCK_SECRET=mock-travelboost-secret
# Tuning (defaults shown)
WA_MAX_SENDS_PER_SECOND=20
BROADCAST_BATCH_SIZE=50
DEBOUNCE_SECONDS_OVERRIDE=
